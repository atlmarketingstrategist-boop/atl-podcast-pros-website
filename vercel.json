{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.atlpodcastpros.com" }],
      "destination": "https://atlpodcastpros.com/$1",
      "statusCode": 301
    },
    { "source": "/podcast-pro-packages", "destination": "/services", "statusCode": 301 },
    { "source": "/podcast-pro-packages/", "destination": "/services", "statusCode": 301 },
    { "source": "/feed", "destination": "/blog", "statusCode": 301 },
    { "source": "/feed/", "destination": "/blog", "statusCode": 301 },
    { "source": "/contact-us", "destination": "/book", "statusCode": 301 },
    { "source": "/contact-us/", "destination": "/book", "statusCode": 301 },
    { "source": "/podcast-equipment-list", "destination": "/services", "statusCode": 301 },
    { "source": "/podcast-equipment-list/", "destination": "/services", "statusCode": 301 },
    { "source": "/faqs", "destination": "/how-it-works", "statusCode": 301 },
    { "source": "/faqs/", "destination": "/how-it-works", "statusCode": 301 },
    { "source": "/contact", "destination": "/book", "statusCode": 301 },
    { "source": "/contact/", "destination": "/book", "statusCode": 301 },
    { "source": "/about-us", "destination": "/about", "statusCode": 301 },
    { "source": "/about-us/", "destination": "/about", "statusCode": 301 },
    { "source": "/home", "destination": "/", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
